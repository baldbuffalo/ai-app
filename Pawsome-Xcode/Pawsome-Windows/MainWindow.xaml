<Window x:Class="PawsomeAI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pawsome AI" Height="700" Width="900">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8">
            <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send" Width="70" Click="SendBtn_Click"/>
            <TextBox x:Name="InputBox" Margin="0,0,8,0"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="Gray"/>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
